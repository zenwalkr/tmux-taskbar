#!/usr/bin/env bash

# tmux-taskbar extension: compact Linux uptime display.

set -u

uptime_seconds=$(awk 'NR == 1 { print int($1) }' /proc/uptime 2>/dev/null || true)
if ! [[ "$uptime_seconds" =~ ^[0-9]+$ ]]; then
    printf 'UP:--\n'
    exit 0
fi

days=$((uptime_seconds / 86400))
hours=$(((uptime_seconds % 86400) / 3600))
minutes=$(((uptime_seconds % 3600) / 60))

if [ "$days" -gt 0 ]; then
    printf 'UP:%sd %sh\n' "$days" "$hours"
elif [ "$hours" -gt 0 ]; then
    printf 'UP:%sh %sm\n' "$hours" "$minutes"
else
    printf 'UP:%sm\n' "$minutes"
fi
